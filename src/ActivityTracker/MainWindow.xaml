<Window x:Class="ActivityTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ActivityTracker"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        mc:Ignorable="d"
        Title="Activity Tracker - Paused" Height="780" Width="740" Icon="Assets/AppIcon.ico">
    <Window.Resources>
        <!-- Shared table-cell templates: every table cell shows its full text
             as a tooltip, since GridView columns clip long text with no
             visible indication otherwise. Reused by property name across the
             different row types (WindowUsageRow/SwitchLogRow/TimelineRow all
             have a "Process"/"WindowTitle" property, etc.) since XAML data
             binding resolves by name, not by declared CLR type. -->
        <DataTemplate x:Key="LabelCellTemplate">
            <TextBlock Text="{Binding Label}" ToolTip="{Binding Label}" TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
        <DataTemplate x:Key="ValueCellTemplate">
            <TextBlock Text="{Binding Value}" ToolTip="{Binding Value}" TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
        <DataTemplate x:Key="ProcessCellTemplate">
            <TextBlock Text="{Binding Process}" ToolTip="{Binding Process}" TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
        <DataTemplate x:Key="WindowTitleCellTemplate">
            <TextBlock Text="{Binding WindowTitle}" ToolTip="{Binding WindowTitle}" TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
        <DataTemplate x:Key="TimeDisplayCellTemplate">
            <TextBlock Text="{Binding TimeDisplay}" ToolTip="{Binding TimeDisplay}" TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
        <DataTemplate x:Key="StartDisplayCellTemplate">
            <TextBlock Text="{Binding StartDisplay}" ToolTip="{Binding StartDisplay}" TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
        <DataTemplate x:Key="EndDisplayCellTemplate">
            <TextBlock Text="{Binding EndDisplay}" ToolTip="{Binding EndDisplay}" TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
        <DataTemplate x:Key="DurationDisplayCellTemplate">
            <TextBlock Text="{Binding DurationDisplay}" ToolTip="{Binding DurationDisplay}" TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
        <DataTemplate x:Key="MemoDisplayCellTemplate">
            <TextBlock Text="{Binding MemoDisplay}" ToolTip="{Binding MemoDisplay}" TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
        <DataTemplate x:Key="NameCellTemplate">
            <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
    </Window.Resources>
    <Grid x:Name="RootGrid">
        <TabControl x:Name="MainTabControl" Margin="10" SelectionChanged="MainTabControl_SelectionChanged">

            <!-- Tracker tab -->
            <TabItem x:Name="TrackerTabItem" Header="Tracker">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Activity Tracker" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

                    <Border Grid.Row="1" BorderBrush="{StaticResource WmpBorderBrush}" BorderThickness="1" Background="{StaticResource WmpPanelBrush}" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" x:Name="StatusIconButton" Click="ToggleButton_Click"
                                    Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Center"
                                    ToolTip="Click to start/stop tracking">
                                <Path x:Name="StatusIconPath" Fill="{StaticResource WmpAccentBrush}" Stretch="Uniform" Width="20" Height="20"/>
                            </Button>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Border ClipToBounds="True" Height="22" Margin="0,0,0,8">
                                    <Canvas x:Name="MarqueeCanvas">
                                        <TextBlock x:Name="MarqueeText" Text="Not tracking" FontWeight="Bold"/>
                                    </Canvas>
                                </Border>
                                <TextBlock>
                                    <Run Text="Current memo: "/>
                                    <Run x:Name="CurrentMemoInlineText" Text="(none)" FontWeight="Bold"/>
                                </TextBlock>
                            </StackPanel>

                            <Border Grid.Column="2" BorderBrush="{StaticResource WmpBorderBrush}" BorderThickness="1" Background="White" CornerRadius="4" Padding="8">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="SessionDurationText" Text="00:00:00" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Current Session" FontSize="10" HorizontalAlignment="Center" Opacity="0.7"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Current memo:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="CurrentMemoBox" Width="220" IsEditable="True" Margin="0,0,8,0"/>
                        <Button Content="Set" Click="SetCurrentMemoButton_Click" Margin="0,0,8,0"/>
                        <Button Content="Clear" Click="ClearCurrentMemoButton_Click" Margin="0,0,8,0"/>
                        <Button Content="Color..." Click="PickCurrentMemoColorButton_Click"/>
                    </StackPanel>

                    <TextBlock Grid.Row="4" Text="Today" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>

                        <ListView Grid.Column="0" x:Name="TodayStatsList" Margin="0,0,12,0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Metric" Width="180" CellTemplate="{StaticResource LabelCellTemplate}"/>
                                    <GridViewColumn Header="Value" Width="260" CellTemplate="{StaticResource ValueCellTemplate}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <lvc:PieChart Grid.Column="1" x:Name="TodayPieChart" LegendPosition="Bottom"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Summary tab -->
            <TabItem x:Name="SummaryTabItem" Header="Summary">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="220"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Date:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker x:Name="SummaryDatePicker" Width="130" SelectedDateChanged="SummaryDatePicker_SelectedDateChanged" Margin="0,0,12,0"/>
                        <Button Content="Refresh" Click="RefreshSummaryButton_Click" Margin="0,0,8,0"/>
                        <Button Content="Open Logs Folder" Click="OpenLogsFolderButton_Click" Margin="0,0,8,0"/>
                        <Button Content="Open Log in Notepad" Click="OpenTodayLogButton_Click"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <lvc:CartesianChart Grid.Column="0" x:Name="WindowUsageChart" Margin="0,0,8,0"/>
                        <lvc:PieChart Grid.Column="1" x:Name="TopWebsitesChart" LegendPosition="Right"/>
                    </Grid>

                    <TextBlock Grid.Row="2" x:Name="WindowUsageHeaderText" Text="Time per window" FontWeight="Bold" Margin="0,0,0,4"/>
                    <ListView Grid.Row="3" x:Name="WindowUsageList" Margin="0,0,0,12">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Process" Width="140" CellTemplate="{StaticResource ProcessCellTemplate}"/>
                                <GridViewColumn Header="Window Title" Width="330" CellTemplate="{StaticResource WindowTitleCellTemplate}"/>
                                <GridViewColumn Header="Time" Width="90" CellTemplate="{StaticResource TimeDisplayCellTemplate}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <TextBlock Grid.Row="4" x:Name="SwitchLogHeaderText" Text="Window switch log" FontWeight="Bold" Margin="0,0,0,4"/>
                    <ListView Grid.Row="5" x:Name="SwitchLogList">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Start" Width="80" CellTemplate="{StaticResource StartDisplayCellTemplate}"/>
                                <GridViewColumn Header="End" Width="80" CellTemplate="{StaticResource EndDisplayCellTemplate}"/>
                                <GridViewColumn Header="Process" Width="110" CellTemplate="{StaticResource ProcessCellTemplate}"/>
                                <GridViewColumn Header="Window Title" Width="230" CellTemplate="{StaticResource WindowTitleCellTemplate}"/>
                                <GridViewColumn Header="Duration" Width="80" CellTemplate="{StaticResource DurationDisplayCellTemplate}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>

            <!-- Timeline tab -->
            <TabItem x:Name="TimelineTabItem" Header="Timeline">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Date:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker x:Name="TimelineDatePicker" Width="130" SelectedDateChanged="TimelineDatePicker_SelectedDateChanged" Margin="0,0,12,0"/>
                        <TextBlock Text="Order:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="TimelineSortOrderBox" Width="120" SelectionChanged="TimelineSortOrderBox_SelectionChanged" Margin="0,0,12,0">
                            <ComboBoxItem Content="Earliest first"/>
                            <ComboBoxItem Content="Latest first"/>
                        </ComboBox>
                        <Button Content="Refresh" Click="RefreshTimelineButton_Click" Margin="0,0,8,0"/>
                        <Button x:Name="DeleteTimelineButton" Content="Delete Selected" IsEnabled="False" Click="DeleteTimelineButton_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Search window title:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="TimelineSearchBox" Width="220" TextChanged="TimelineSearchBox_TextChanged" Margin="0,0,16,0"/>
                        <TextBlock Text="Memo:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="TimelineMemoFilterBox" Width="180" SelectionChanged="TimelineMemoFilterBox_SelectionChanged"/>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="TimelineStripStartText" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Border Grid.Column="1" BorderBrush="{StaticResource WmpBorderBrush}" BorderThickness="1">
                            <Canvas x:Name="TimelineStripCanvas" Height="40" ClipToBounds="True" SizeChanged="TimelineStripCanvas_SizeChanged"/>
                        </Border>
                        <TextBlock Grid.Column="2" x:Name="TimelineStripEndText" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </Grid>

                    <ListView Grid.Row="3" x:Name="TimelineList" SelectionMode="Extended" SelectionChanged="TimelineList_SelectionChanged" Margin="0,0,0,10">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Start" Width="80" CellTemplate="{StaticResource StartDisplayCellTemplate}"/>
                                <GridViewColumn Header="End" Width="80" CellTemplate="{StaticResource EndDisplayCellTemplate}"/>
                                <GridViewColumn Header="Duration" Width="80" CellTemplate="{StaticResource DurationDisplayCellTemplate}"/>
                                <GridViewColumn Header="Process" Width="110" CellTemplate="{StaticResource ProcessCellTemplate}"/>
                                <GridViewColumn Header="Window Title" Width="230" CellTemplate="{StaticResource WindowTitleCellTemplate}"/>
                                <GridViewColumn Header="Memo" Width="130" CellTemplate="{StaticResource MemoDisplayCellTemplate}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="4" Orientation="Horizontal">
                        <TextBlock Text="Apply memo to selected:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="TimelineMemoBox" Width="220" IsEditable="True" Margin="0,0,8,0"/>
                        <Button Content="Apply to Selected" Click="ApplyMemoButton_Click" Margin="0,0,8,0"/>
                        <Button Content="Clear Memo on Selected" Click="ClearMemoButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Trends tab -->
            <TabItem x:Name="TrendsTabItem" Header="Trends">
                <StackPanel Margin="16">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Trends" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="Refresh Trends" Click="RefreshTrendsButton_Click"/>
                    </StackPanel>

                    <TextBlock Text="Activity by hour (all-time)" FontWeight="Bold" Margin="0,0,0,8"/>
                    <lvc:CartesianChart x:Name="HourlyChart" Height="220" Margin="0,0,0,24"/>

                    <TextBlock Text="App usage - last 7 days" FontWeight="Bold" Margin="0,0,0,8"/>
                    <lvc:CartesianChart x:Name="WeeklyChart" Height="240"/>
                </StackPanel>
            </TabItem>

            <!-- Memos tab -->
            <TabItem x:Name="MemosTabItem" Header="Memos">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Memos" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

                    <ListView Grid.Row="1" x:Name="MemoManagementList" SelectionChanged="MemoManagementList_SelectionChanged" Margin="0,0,0,12">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Color" Width="60">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="20" Height="20" CornerRadius="3" BorderBrush="{StaticResource WmpBorderBrush}" BorderThickness="1" Background="{Binding ColorBrush}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Name" Width="300" CellTemplate="{StaticResource NameCellTemplate}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <TextBlock Text="Name:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="MemoEditNameBox" Width="200" Margin="0,0,12,0"/>
                        <Border x:Name="MemoEditColorSwatch" Width="24" Height="24" BorderBrush="{StaticResource WmpBorderBrush}" BorderThickness="1" Margin="0,0,8,0"/>
                        <Button Content="Change Color..." Click="MemoEditColorButton_Click" Margin="0,0,12,0"/>
                        <Button Content="Save Changes" Click="SaveMemoEditButton_Click" Margin="0,0,8,0"/>
                        <Button Content="Delete Memo" Click="DeleteMemoButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Settings tab -->
            <TabItem Header="Settings">
                <ScrollViewer Margin="16" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Settings" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

                        <TextBlock Text="Idle poll interval (seconds)" Margin="0,0,0,2"/>
                        <TextBox x:Name="IdlePollIntervalBox" Width="100" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                        <TextBlock Text="Idle threshold (seconds)" Margin="0,0,0,2"/>
                        <TextBox x:Name="IdleThresholdBox" Width="100" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                        <TextBlock Text="Coding process names (one per line)" Margin="0,0,0,2"/>
                        <TextBox x:Name="CodingProcessNamesBox" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                        <TextBlock Text="Browser process names (one per line)" Margin="0,0,0,2"/>
                        <TextBox x:Name="BrowserProcessNamesBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                        <TextBlock Text="Window background image" Margin="0,0,0,2"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBox x:Name="WallpaperPathBox" Width="330" IsReadOnly="True" Margin="0,0,8,0"/>
                            <Button Content="Browse..." Click="BrowseWallpaperButton_Click" Margin="0,0,8,0"/>
                            <Button Content="Clear" Click="ClearWallpaperButton_Click"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Save Settings" Width="120" Click="SaveSettingsButton_Click" Margin="0,0,8,0"/>
                            <TextBlock x:Name="SettingsSavedText" VerticalAlignment="Center" Text=""/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
