<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- XP Luna / classic Media Player palette -->
    <LinearGradientBrush x:Key="WmpWindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E9F2FC" Offset="0"/>
        <GradientStop Color="#C6DCF7" Offset="0.5"/>
        <GradientStop Color="#9DC0EF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WmpPanelBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FDFEFF" Offset="0"/>
        <GradientStop Color="#DCEBFC" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WmpButtonFaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FAFDFF" Offset="0"/>
        <GradientStop Color="#C6DCF7" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WmpButtonHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#E1EEFC" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WmpButtonPressedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B7D2F2" Offset="0"/>
        <GradientStop Color="#8FB6E8" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="WmpBorderBrush" Color="#5A85C4"/>
    <SolidColorBrush x:Key="WmpTitleBlueBrush" Color="#0A246A"/>
    <SolidColorBrush x:Key="WmpAccentBrush" Color="#316AC5"/>
    <SolidColorBrush x:Key="WmpTextBrush" Color="#0A246A"/>

    <FontFamily x:Key="WmpFontFamily">Tahoma</FontFamily>

    <!-- Window -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource WmpWindowBackgroundBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource WmpFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource WmpTextBrush}"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource WmpTextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource WmpFontFamily}"/>
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource WmpTextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource WmpFontFamily}"/>
    </Style>

    <!-- Button: rounded gradient face with hover/pressed states -->
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource WmpFontFamily}"/>
        <Setter Property="Foreground" Value="{StaticResource WmpTextBrush}"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{StaticResource WmpButtonFaceBrush}"
                            BorderBrush="{StaticResource WmpBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource WmpButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource WmpButtonPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TextBox -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource WmpFontFamily}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource WmpBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="3"/>
    </Style>

    <!-- TabItem: rounded-top tab that looks pressed-in when selected -->
    <Style TargetType="TabItem">
        <Setter Property="FontFamily" Value="{StaticResource WmpFontFamily}"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabBorder"
                            Background="{StaticResource WmpButtonFaceBrush}"
                            BorderBrush="{StaticResource WmpBorderBrush}"
                            BorderThickness="1,1,1,0"
                            CornerRadius="4,4,0,0"
                            Margin="1,0">
                        <ContentPresenter x:Name="Content"
                                          ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource WmpPanelBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="False">
                            <Setter TargetName="Content" Property="Opacity" Value="0.75"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource WmpBorderBrush}"/>
        <Setter Property="Padding" Value="8"/>
    </Style>

    <!-- ListView tables (Summary tab) -->
    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Background" Value="{StaticResource WmpButtonFaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource WmpTextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource WmpFontFamily}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="BorderBrush" Value="{StaticResource WmpBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>

    <Style TargetType="ListView">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource WmpBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource WmpFontFamily}"/>
    </Style>

</ResourceDictionary>
